rules_version = '2';

// Regras do Firestore do PokeQuiz. Publique com:
//   firebase deploy --only firestore:rules
// ou cole no console: Firestore Database → Regras.
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil completo (e-mail, idade, cidade...): só o próprio usuário.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ranking público: qualquer usuário logado lê; cada um só escreve o seu.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.best is map
        && (request.resource.data.thumb == null
            || (request.resource.data.thumb is string
                && request.resource.data.thumb.size() < 20000));
    }
  }
}
